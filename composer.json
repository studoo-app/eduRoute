{
    "name": "studoo/edu-route",
    "description": "Fast request router for PHP 8.4+ (modernized fork of nikic/fast-route)",
    "license": "BSD-3-Clause",
    "keywords": [
        "routing",
        "router",
        "education"
    ],
    "authors": [
        {
            "name": "Nikita Popov",
            "email": "nikic@php.net"
        },
        {
            "name": "Benoit Foujols"
        },
        {
            "name": "Studoo Community",
            "homepage": "https://github.com/orgs/studoo-app/people"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "lcobucci/coding-standard": "^12.1",
        "nyholm/psr7": "^1.8.2",
        "phpbench/phpbench": "^1.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "psr/http-factory": "^1.1",
        "psr/http-server-middleware": "^1.0.2",
        "rector/rector": "^2.8"
    },
    "suggest": {
        "psr/http-server-middleware": "Pour utiliser Studoo\\EduRoute\\Http\\RoutingMiddleware (PSR-15)",
        "psr/http-factory": "Pour utiliser Studoo\\EduRoute\\Http\\RoutingMiddleware (réponses 404/405 PSR-17)"
    },
    "autoload": {
        "psr-4": {
            "Studoo\\EduRoute\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Studoo\\EduRoute\\Benchmark\\": "benchmark/",
            "Studoo\\EduRoute\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.4.1"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.1-dev"
        }
    }
}
