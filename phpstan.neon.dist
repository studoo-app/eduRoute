parameters:
    level: max
    phpVersion:
        min: 80400
        max: 80599
    paths:
        - benchmark
        - src
        - test

    reportUnmatchedIgnoredErrors: true
    # Exige #[\Override] (PHP 8.3) sur toute méthode qui implémente/redéfinit une méthode parente
    checkMissingOverrideMethodAttribute: true

    ignoreErrors:
        # Faux positifs : PHPStan 2.3 ne modélise pas `public public(set) readonly` (PHP 8.4).
        # Les objets résultat sont « write-once » : écrits une seule fois par les dispatchers,
        # sans constructeur (un appel de constructeur coûte ~10 % par route trouvée).
        # L'immuabilité réelle est vérifiée par DispatcherTestCase::resultsAreImmutable().
        -
            identifier: property.readOnlyAssignOutOfClass
            message: '#^Readonly property Studoo\\EduRoute\\Dispatcher\\Result\\(Matched|MethodNotAllowed)::\$\w+ is assigned outside of its declaring class\.$#'
            path: src/Dispatcher/*
        -
            identifier: property.uninitializedReadonly
            path: src/Dispatcher/Result/*
