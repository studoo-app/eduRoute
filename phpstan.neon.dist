includes:
    # Dette technique connue, à résorber en phase 2 (objets résultat du dispatcher
    # en "@readonly" PHPDoc → visibilité asymétrique / constructeur). Ne pas y ajouter
    # de nouvelles entrées : corriger le code à la place.
    - phpstan-baseline.neon

parameters:
    level: max
    phpVersion:
        min: 80400
        max: 80599
    paths:
        - benchmark
        - src
        - test

    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # We're marking this as deprecated, there's no point in alerting ourselves here...
        - '#Call to deprecated function FastRoute\\(cached|simple)Dispatcher.*#'
